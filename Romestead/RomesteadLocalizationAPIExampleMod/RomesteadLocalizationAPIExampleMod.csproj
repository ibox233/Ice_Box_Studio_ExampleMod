<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>RomesteadLocalizationAPIExampleMod</AssemblyName>
    <RootNamespace>RomesteadLocalizationAPIExampleMod</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA2252;CA1416</NoWarn>

    <GamePath Condition="'$(GamePath)' == ''">F:\SteamLibrary\steamapps\common\romestead</GamePath>
    <GameBepInExPath Condition="'$(GameBepInExPath)' == ''">$(GamePath)\BepInEx</GameBepInExPath>
    <GamePluginsPath Condition="'$(GamePluginsPath)' == ''">$(GameBepInExPath)\plugins</GamePluginsPath>
    <ModPath>$(MSBuildProjectDirectory)</ModPath>
    <GameModPluginsPath>$(GamePluginsPath)\$(AssemblyName)</GameModPluginsPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameBepInExPath)\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.NET.Common">
      <HintPath>$(GameBepInExPath)\core\BepInEx.NET.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RomesteadLocalizationAPI">
      <HintPath>..\RomesteadLocalizationAPI\bin\Debug\RomesteadLocalizationAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <LocalizationFile Include="Localization\Localization.json" />
  </ItemGroup>

  <Target Name="CopyToGamePlugins" AfterTargets="Build">
    <MakeDir Directories="$(GameModPluginsPath)" Condition="Exists('$(GamePluginsPath)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameModPluginsPath)" SkipUnchangedFiles="true" Condition="Exists('$(GamePluginsPath)')" />
    <Copy SourceFiles="@(LocalizationFile)" DestinationFiles="@(LocalizationFile->'$(GameModPluginsPath)\%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(GamePluginsPath)') and '@(LocalizationFile)' != ''" />
    <Delete Files="$(GamePluginsPath)\$(TargetFileName)" Condition="Exists('$(GamePluginsPath)\$(TargetFileName)')" />
  </Target>
</Project>
